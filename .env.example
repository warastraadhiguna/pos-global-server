# Salin file ini ke .env dan sesuaikan dengan environment lokal.
# Jangan commit .env yang sebenarnya (berisi credential).

# --- Server ---
PORT=4000
HOST=0.0.0.0
# Opsional — cuma diisi kalau folder pos-admin TIDAK bertetangga dengan
# folder server ini (defaultnya diasumsikan satu tingkat di atas, folder
# sama: ../pos-admin/dist relatif dari server/). Isi dengan path absolut ke
# folder pos-admin/dist kalau strukturnya beda, mis. server dipindah sendiri
# ke drive/folder lain.
# ADMIN_DIST_PATH=D:\program\pos-admin\dist

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_branch

# --- Auth ---
# WAJIB diganti dengan string acak panjang sebelum deploy ke produksi.
JWT_SECRET=change-this-to-a-long-random-string-before-production
JWT_EXPIRES_IN=12h

# --- Seed (development only) ---
SEED_ADMIN_PASSWORD=admin123
SEED_CASHIER_PIN=1234
